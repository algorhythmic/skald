{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session record contract v1",
  "description": "See docs/CONTRACT-V1.md for identity, digest and cross-field semantic checks.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "source_namespace": {
      "type": "string",
      "minLength": 1
    },
    "origin_scope": {
      "$ref": "#/$defs/scope"
    },
    "conversation_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "record_key": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "$ref": "#/$defs/digest"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "message",
        "tool_call",
        "tool_result",
        "title",
        "native_recap",
        "native_summary",
        "native_note",
        "compaction_marker",
        "lifecycle_observation",
        "opaque_record"
      ]
    },
    "native_kind": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_order": {
      "anyOf": [
        {
          "$ref": "#/$defs/order"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "$ref": "#/$defs/body"
    },
    "raw_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "availability": {
      "$ref": "#/$defs/availability"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "source_namespace",
    "origin_scope",
    "conversation_key",
    "record_key",
    "source_revision",
    "provider",
    "provider_version",
    "adapter_version",
    "kind",
    "native_kind",
    "role",
    "channel",
    "source_time",
    "source_order",
    "observed_at",
    "body",
    "raw_ref",
    "coverage",
    "provenance",
    "relations",
    "availability"
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "conversation",
            "project",
            "source"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "properties": {
        "stream_generation": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "stream_generation",
        "ordinal"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "record_key": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "record_key",
        "source_revision"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "native",
            "user_annotation",
            "imported_external"
          ]
        },
        "producer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "producer"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "target",
        "evidence"
      ],
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "text",
            "tool_call",
            "tool_result",
            "opaque"
          ]
        },
        "text": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "available"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "partial",
                "unsupported",
                "opaque",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "coverage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "collector_cutoff"
            },
            "through": {
              "$ref": "#/$defs/order"
            }
          },
          "required": [
            "kind",
            "through"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "native_range"
            },
            "start": {
              "$ref": "#/$defs/order"
            },
            "end": {
              "$ref": "#/$defs/order"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      ]
    },
    "body": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "state": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin_scope": {
            "properties": {
              "kind": {
                "const": "conversation"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "conversation_key": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "conversation_key": {
            "type": "null"
          }
        }
      }
    }
  ]
}
